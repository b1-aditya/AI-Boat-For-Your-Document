# Google Gemini ki free API key yahan daalein (https://aistudio.google.com/apikey se milegi)
GOOGLE_API_KEY=AIza_your_google_api_key_here

# Aapke RAG REST API (api.py) ki security ke liye khud ki API key
RAG_API_KEY=rag_your_custom_secret_api_key_here

# ChromaDB Deployment Mode: "local" | "http" | "cloud"
CHROMA_MODE=local
CHROMA_PERSIST_DIR=chroma_db

# Agar ChromaDB ko alag live server (Render/Railway/VPS) par deploy karein (CHROMA_MODE=http):
# CHROMA_HOST=your-chroma-server.onrender.com
# CHROMA_PORT=443
# CHROMA_SSL=true

# Agar Chroma Cloud (trychroma.com) use karein (CHROMA_MODE=cloud):
# CHROMA_API_KEY=ck-your-chroma-cloud-key
# CHROMA_TENANT=your-tenant-id
# CHROMA_DATABASE=your-database-name

# Optional: Agar Groq bhi use karna ho to neeche key daalein
# GROQ_API_KEY=gsk_your_groq_api_key_here
